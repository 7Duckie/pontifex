# .distignore — paths excluded from the distributed plugin package.
#
# Used by `wp dist-archive` to build the ZIP that ships to WordPress.org.
# Patterns are matched gitignore-style WITHOUT a leading slash (a leading
# slash is not honoured by dist-archive's matcher). The shipped package is
# the runtime only: pontifex.php, src/, vendor/, languages/, assets/,
# readme.txt, LICENSE, CHANGELOG.md and composer.json. Everything below is
# development,
# CI, testing, or internal documentation with no place in a user's site.

# Version control, CI, and editor / OS metadata
.git
.github
.gitattributes
.gitignore
.idea
.claude
.editorconfig
.DS_Store
.phpunit.cache
.pre-commit-config.yaml
.wp-env.json
.wp-env.override.json
.wp-env.tests.json
.wp-env.tests.override.json
.wp-env.plugin-check.json
.distignore

# Build and QA configuration (not needed at runtime)
phpcs.xml.dist
phpstan.neon.dist
phpunit.xml.dist
phpunit-integration.xml.dist
build
stubs
composer.lock

# Node tooling (wp-env only; the plugin itself ships no JavaScript build)
node_modules
package.json
package-lock.json

# Test-only tooling configuration (Patchwork lets brain/monkey redefine PHP
# internals in unit tests; it has no runtime role and must not ship)
patchwork.json

# Mutation testing (local, advisory; never shipped)
infection.json5
infection.log

# Tests, build scripts, and documentation source
tests
scripts
docs

# GitHub-facing and internal working documents (the wp.org listing uses
# readme.txt). Working notes and handoffs live in one directory, not a
# per-file list, so that a document added later is excluded automatically. A
# hand-maintained list of dated filenames rots: this one did, and four
# documents reached a built package because nobody remembered to add them to
# the list. A glob cannot fix this either: dist-archive passes its exclusions
# through PHP's escapeshellcmd(), which backslash-escapes `*`, so a pattern
# such as "dated-name-*.md" reaches tar as a literal escaped string and
# matches nothing. CLAUDE.md must stay at the repository root, so it is
# listed on its own.
README.md
CLAUDE.md
notes
