<?xml version="1.0"?>
<ruleset name="Pontifex">
    <description>PHP_CodeSniffer ruleset for Pontifex.</description>

    <!-- Files to inspect. -->
    <file>pontifex.php</file>
    <file>src/</file>
    <file>tests/</file>

    <!-- Patterns to exclude. -->
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>tests/fixtures/*</exclude-pattern>

    <!-- Show progress and use colours. -->
    <arg value="ps"/>
    <arg name="colors"/>

    <!-- Run on multiple cores when available. -->
    <arg name="parallel" value="8"/>

    <!-- Allow only PHP files to be sniffed. -->
    <arg name="extensions" value="php"/>

    <!--
        WordPress-Extra includes:
          - WordPress-Core (formatting, naming)
          - WordPress-Docs (DocBlocks)
          - WordPress-Extra (best practices)
        We deliberately do NOT include WordPress-VIP, which is for the
        wordpress.com hosted environment and forbids things we want.
    -->
    <rule ref="WordPress-Extra"/>
    <rule ref="WordPress-Docs"/>

    <!--
        WordPress-Extra includes four of the five WordPress security sniffs
        but NOT ValidatedSanitizedInput, which flags superglobal input used
        without a recognised sanitiser. Plugin Check — the gate a plugin must
        pass to be listed in the directory — does include it, so a finding it
        raises could only ever surface at the staging gate, after the local
        gates had already said the change was clean. One did, on the v1.0.3
        assembly. Enabling it here means `composer lint` sees what the
        directory's own tooling sees.
    -->
    <rule ref="WordPress.Security.ValidatedSanitizedInput"/>

    <!--
        File-naming rules: PSR-4 vs traditional WordPress.

        WPCS by default requires files in the WordPress style:
        `class-foo-bar.php` for classes, lowercase hyphenated for the rest.
        That conflicts with PSR-4 autoloading, which requires the file
        name to match the class name in PascalCase (so `FooBar.php` for
        class `FooBar`). Since Pontifex uses Composer/PSR-4 for autoload,
        we exempt the autoloaded directories from those rules.

        The exemption is targeted: the file-naming rules still apply to
        pontifex.php at the project root and any other non-PSR-4 file.
    -->
    <rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
        <exclude-pattern>src/*</exclude-pattern>
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.Files.FileName.InvalidClassFileName">
        <exclude-pattern>src/*</exclude-pattern>
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- Tell the standards where to find our text-domain. -->
    <config name="text_domain" value="pontifex"/>

    <!-- Plugin/class prefix enforcement: nothing in Pontifex's code
         should be in the global namespace without a Pontifex prefix. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="pontifex"/>
                <element value="Pontifex"/>
                <element value="PONTIFEX_"/>
            </property>
        </properties>
    </rule>

    <!--
        WordPress-Extra does not include WordPress.DB.DirectDatabaseQuery,
        which flags database access that bypasses the WordPress API.
        Plugin Check does include it, so this is the same gap as
        ValidatedSanitizedInput above. Pontifex's shipped code trips it
        nowhere — the places it would are already carrying exact-sniff
        `phpcs:ignore` comments written for Plugin Check. The integration
        suite creates and drops its own fixture tables, which produces 59
        findings that describe the test harness rather than the plugin;
        `tests/` is excluded because Plugin Check never looks at it, since
        it inspects the built package, not the source tree.
    -->
    <rule ref="WordPress.DB.DirectDatabaseQuery">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!--
        WordPress-Extra does not include WordPress.DB.SlowDBQuery either,
        and Plugin Check runs it unmodified. No exclusions: Pontifex is
        clean everywhere today.
    -->
    <rule ref="WordPress.DB.SlowDBQuery"/>

    <!--
        Squiz.PHP.DiscouragedFunctions is not part of WordPress-Extra, and
        Plugin Check runs it with its own list of forbidden functions, not
        the sniff's PHPCS default (error_log, print_r, var_dump — which
        has nothing to do with what Plugin Check checks for). The
        properties block below is not optional: leaving it out would go
        green while checking for the wrong functions entirely, so it is
        replaced with Plugin Check's own list. `tests/` is excluded
        because five unit tests call `ini_set()` as legitimate test setup.
    -->
    <rule ref="Squiz.PHP.DiscouragedFunctions">
        <exclude-pattern>tests/*</exclude-pattern>
        <properties>
            <property name="forbiddenFunctions" type="array">
                <element key="set_time_limit" value="null"/>
                <element key="ini_set" value="null"/>
                <element key="ini_alter" value="null"/>
                <element key="dl" value="null"/>
            </property>
        </properties>
    </rule>

    <!--
        Generic.PHP.ForbiddenFunctions is already active via WordPress-
        Extra, but only with the PHPCS default list of `sizeof` and
        `delete`. Plugin Check runs the same sniff with fourteen further
        entries, so the full, explicit sixteen-entry list is declared
        here rather than reached for with `extend="true"`: extend only
        merges with a value a ruleset has already set for the property,
        never with the sniff's own built-in default, so because
        WordPress-Extra never sets this property itself, `extend="true"`
        would start from an empty array and silently drop `sizeof` and
        `delete` — weakening the gate while appearing to strengthen it.
    -->
    <rule ref="Generic.PHP.ForbiddenFunctions">
        <properties>
            <property name="forbiddenFunctions" type="array">
                <element key="sizeof" value="count"/>
                <element key="delete" value="unset"/>
                <element key="move_uploaded_file" value="null"/>
                <element key="passthru" value="null"/>
                <element key="proc_open" value="null"/>
                <element key="create_function" value="null"/>
                <element key="eval" value="null"/>
                <element key="str_rot13" value="null"/>
                <element key="_cleanup_header_comment" value="null"/>
                <element key="_get_plugin_data_markup_translate" value="null"/>
                <element key="_transition_post_status" value="null"/>
                <element key="_wp_post_revision_fields" value="null"/>
                <element key="do_shortcode_tag" value="null"/>
                <element key="get_post_type_labels" value="null"/>
                <element key="wp_get_sidebars_widgets" value="null"/>
                <element key="wp_get_widget_defaults" value="null"/>
            </property>
        </properties>
    </rule>

    <!-- Minimum PHP version for compatibility sniffs. -->
    <config name="testVersion" value="8.1-"/>
</ruleset>
